{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kontomatik Account Information Service Aggregation API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Aggregation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Aggregated Data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.kontomatik.com/v1/data/aggregated",
            "params": [
              {
                "name": "ownerExternalId",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Aggregates data across multiple import sessions for a single owner."
        }
      ]
    }
  ],
  "bundled": true
}