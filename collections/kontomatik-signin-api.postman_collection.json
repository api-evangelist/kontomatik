  "info": {
    "_postman_id": "fd2bd8a2-69c6-4ffd-bfde-82b97bbaf046",
    "name": "Kontomatik Account Information Service Aggregation SignIn API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "PSD2-regulated Account Information Service (AIS) for connecting to end-user\nbank accounts across Central and Eastern Europe. Supports Single Access\n(one-time data fetch) and Multiple Access (reusable consent token, up to\n180 days), redirection-based SignIn Flow, and mock-bank testing.\n\n\nContact Support:\n Name: Kontomatik Support\n Email: support@kontomatik.com",
      "type": "text/plain"
    }
  }
