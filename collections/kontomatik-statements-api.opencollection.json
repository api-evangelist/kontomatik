{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kontomatik Account Information Service Aggregation Statements API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Statements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Parse Statement (Standard)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.kontomatik.com/v1/pdf/statement",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "pdf",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "ownerExternalId",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "password",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Parses a bank statement PDF and returns structured data. Rejects with errors if verification inconsistencies are detected."
        },
        {
          "info": {
            "name": "Parse Statement (Trusted)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.kontomatik.com/v1/pdf/statement-trusted",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "pdf",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "ownerExternalId",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "password",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Parses a bank statement PDF and returns data even when verification fails. Use when the source is trusted."
        },
        {
          "info": {
            "name": "List Parsed Statements",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.kontomatik.com/v1/pdf/statements",
            "params": [
              {
                "name": "ownerExternalId",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Lists previously parsed statement documents for a given owner."
        }
      ]
    }
  ],
  "bundled": true
}